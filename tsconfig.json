{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@pages": [
        "./app/pages/index.ts"
      ],
      "@api": [
        "./app/api/index.ts"
      ],
      "@data": [
        "./tests/search/data/index.ts"
      ],
      "@fixtures": [
        "./tests/fixtures/index.ts"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "tests/fixtures/**/*.ts",
    "tests/search/data/**/*.ts",
    "tests/**/*.ts",
    "src/**/*.ts",
    "*.ts",
    "eslint.config.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
