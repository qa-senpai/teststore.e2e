{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@pages": ["./pages/index.ts"],
      "@data": ["tests/search/data/index.ts"],
      "@fixtures": ["./fixtures/index.ts"]
    }
  },
  "include": [
    "pages/**/*.ts",
    "fixtures/**/*.ts",
    "tests/search/data/**/*.ts",
    "tests/**/*.ts",
    "src/**/*.ts",
    "*.ts",
    "eslint.config.mts"
  ],
  "exclude": ["node_modules"]
}
